{
  "name": "VSN",
  "author": "Colors from VS Code's Dark 2026 theme (MIT, Microsoft)",
  "themes": [
    {
      "name": "Dark 2026",
      "mode": "dark",
      "font.family": "Segoe UI",
      "font.size": 13,
      "mono_font.family": "Consolas",
      "mono_font.size": 14,
      "radius": 4,
      "radius.lg": 6,
      "shadow": true,
      "colors": {
        "accent.background": "#FFFFFF14",
        "accent.foreground": "#bfbfbf",
        "background": "#121314",
        "border": "#2A2B2C",
        "caret": "#BBBEBF",
        "danger.background": "#f48771",
        "danger.foreground": "#FFFFFF",
        "drag_border": "#3994BC",
        "drop_target.background": "#3994BC1A",
        "foreground": "#bfbfbf",
        "info.background": "#3994BC",
        "info.foreground": "#FFFFFF",
        "input.border": "#333536",
        "link.foreground": "#48A0C7",
        "link.active.foreground": "#53A5CA",
        "link.hover.foreground": "#53A5CA",
        "list.background": "#191A1B",
        "list.active.background": "#FFFFFF22",
        "list.active.border": "#3994BCB3",
        "list.even.background": "#191A1B",
        "list.head.background": "#191A1B",
        "list.hover.background": "#FFFFFF14",
        "muted.background": "#242526",
        "muted.foreground": "#8C8C8C",
        "popover.background": "#202122",
        "popover.foreground": "#bfbfbf",
        "primary.background": "#297AA0",
        "primary.active.background": "#297AA0",
        "primary.foreground": "#FFFFFF",
        "primary.hover.background": "#2B7DA3",
        "ring": "#3994BCB3",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#A8A9AA55",
        "scrollbar.thumb.hover.background": "#A8A9AA90",
        "secondary.background": "#242526",
        "secondary.active.background": "#313233",
        "secondary.foreground": "#bfbfbf",
        "secondary.hover.background": "#FFFFFF10",
        "selection.background": "#276782dd",
        "success.background": "#7ee787",
        "success.foreground": "#121314",
        "tab.background": "#191A1B",
        "tab.active.background": "#121314",
        "tab.active.foreground": "#bfbfbf",
        "tab_bar.background": "#191A1B",
        "tab.foreground": "#8C8C8C",
        "title_bar.background": "#191A1B",
        "title_bar.border": "#2A2B2C",
        "status_bar.background": "#191A1B",
        "status_bar.border": "#2A2B2C",
        "warning.background": "#e5ba7d",
        "warning.foreground": "#121314",
        "overlay": "#00000055",
        "window.border": "#2A2B2C"
      },
      "highlight": {
        "editor.foreground": "#BBBEBF",
        "editor.background": "#121314",
        "editor.active_line.background": "#242526",
        "editor.line_number": "#858889",
        "editor.active_line_number": "#BBBEBF",
        "editor.invisible": "#8384854D",
        "syntax": {
          "attribute": { "color": "#79c0ff" },
          "boolean": { "color": "#79c0ff" },
          "comment": { "color": "#8b949e" },
          "comment.doc": { "color": "#8b949e" },
          "constant": { "color": "#79c0ff" },
          "constructor": { "color": "#ffa657" },
          "embedded": { "color": "#c9d1d9" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#ffa657" },
          "function": { "color": "#d2a8ff" },
          "keyword": { "color": "#ff7b72" },
          "label": { "color": "#79c0ff" },
          "link_text": { "color": "#a5d6ff" },
          "link_uri": { "color": "#a5d6ff" },
          "number": { "color": "#79c0ff" },
          "operator": { "color": "#ff7b72" },
          "preproc": { "color": "#ff7b72" },
          "property": { "color": "#79c0ff" },
          "punctuation": { "color": "#BBBEBF" },
          "punctuation.bracket": { "color": "#BBBEBF" },
          "punctuation.delimiter": { "color": "#BBBEBF" },
          "punctuation.list_marker": { "color": "#ffa657" },
          "punctuation.special": { "color": "#ff7b72" },
          "string": { "color": "#a5d6ff" },
          "string.escape": { "color": "#7ee787" },
          "string.regex": { "color": "#a5d6ff" },
          "string.special": { "color": "#a5d6ff" },
          "string.special.symbol": { "color": "#79c0ff" },
          "tag": { "color": "#7ee787" },
          "text.code.span": { "color": "#79c0ff" },
          "text.literal": { "color": "#79c0ff" },
          "title": { "color": "#79c0ff", "font_weight": 700 },
          "type": { "color": "#ffa657" },
          "variable": { "color": "#c9d1d9" },
          "variable.special": { "color": "#79c0ff" },
          "variant": { "color": "#79c0ff" }
        }
      }
    }
  ]
}
