/// vsn's native plugin API: what a WebAssembly plugin can call in the
/// editor, and what the editor calls in the plugin. Each plugin runs in its
/// own store with a fuel and memory budget, and no file or network access
/// but what its package.json's `vsn.permissions` asks for and the user
/// allows.
package vsn:plugin@0.4.0;

interface editor {
    enum severity { info, warning, error }

    /// A text file open in an editor.
    record document {
        /// As LSP's: "file:///c%3A/...".
        uri: string,
        path: string,
        /// VS Code's language id: "rust", "markdown", ...
        language: string,
        text: string,
    }

    /// A notification, as `vscode.window.show*Message`.
    show-message: func(severity: severity, text: string);
    /// The plugin's status bar item; empty text hides it. `$(name)` draws a codicon.
    set-status: func(text: string);
    /// A line in the plugin's Output channel.
    log: func(text: string);
    /// A setting's value as JSON, from settings.json or else the default in
    /// the plugin's package.json; none when neither has it.
    get-setting: func(key: string) -> option<string>;
    /// The active editor's document, when it's a text file.
    active-document: func() -> option<document>;
    /// Asks the user to pick one of `items`: its index, or none when
    /// dismissed. The plugin waits for the answer.
    show-quick-pick: func(placeholder: string, items: list<string>) -> option<u32>;
    /// Asks the user for a line of text, starting from `value`; none when
    /// dismissed. The plugin waits for the answer.
    show-input-box: func(placeholder: string, value: string) -> option<string>;
    /// Sends the editor a language server notification, as JSON params:
    /// `textDocument/publishDiagnostics`.
    lsp-notify: func(method: string, params: string);
    /// Applies an LSP `WorkspaceEdit`, as JSON.
    apply-edit: func(edit: string);

    /// A file's text. Needs "files" in `vsn.permissions`; the user is asked
    /// the first time, once per session.
    read-file: func(path: string) -> result<string, string>;
    /// Writes a file. Needs "files", as `read-file`.
    write-file: func(path: string, text: string) -> result<_, string>;
    /// A GET request's body as text. Needs "network" in `vsn.permissions`,
    /// and the user's consent as for files.
    fetch: func(url: string) -> result<string, string>;
}

world plugin {
    import editor;

    /// Called once, when an activation event in package.json fires.
    export activate: func();
    /// Runs a command the plugin contributes in package.json. `args` is a
    /// JSON array of its arguments; a menu's file is `{"$uri": "file:///..."}`.
    export run-command: func(command: string, args: string);
    /// Serves the languages listed in package.json's `vsn.languages` as a
    /// language server would: gets each request or notification, its params
    /// as JSON, and answers a request with its JSON result (none is null).
    /// The documents' didOpen, didChange and didClose come this way too.
    export lsp: func(method: string, params: string) -> option<string>;
}
